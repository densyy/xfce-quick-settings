#!/bin/sh
# fake pactl para tests/test-audio.c. Rode com PATH=tests/fakebin.
# Loga argv em $QS_FAKE_LOG (para pactl_move_streams).
if [ -n "${QS_FAKE_LOG:-}" ]; then printf '%s\n' "pactl $*" >> "$QS_FAKE_LOG"; fi
case "$*" in
"list short sinks")
printf '0\talsa_output.pci-0\tmodule-alsa\n1\tbluez_output.AB\tmodule-bluez\n';;
"list sinks")
printf 'Sink #0\n\tState: RUNNING\n\tName: alsa_output.pci-0\n\tDescription: Built-in Audio\nSink #1\n\tState: IDLE\n\tName: bluez_output.AB\n\tDescription: Headphones\n';;
"get-default-sink")
printf 'alsa_output.pci-0\n';;
"list short sources")
printf '0\talsa_input.pci-0\tmodule-alsa\n1\tbluez_output.AB.monitor\tmodule-bluez\n2\talsa_output.pci-0.monitor\tmodule-alsa\n';;
"list sources")
printf 'Source #0\n\tState: RUNNING\n\tName: alsa_input.pci-0\n\tDescription: Built-in Mic\n\tMonitor of Sink: n/a\nSource #1\n\tState: IDLE\n\tName: bluez_output.AB.monitor\n\tDescription: Monitor of Headphones\n\tMonitor of Sink: 1\nSource #2\n\tState: IDLE\n\tName: alsa_output.pci-0.monitor\n\tDescription: Monitor of Built-in Audio\n\tMonitor of Sink: 0\n';;
"get-default-source")
printf 'alsa_input.pci-0\n';;
"list short sink-inputs")
printf '5\t0\tfoo\n9\t1\tbar\n';;
*) exit 0;;
esac

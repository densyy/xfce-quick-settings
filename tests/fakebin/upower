#!/bin/sh
# upower falso para testes: responde `upower -e` e `upower -i <path>`.
# 100% printf (sem cat): funciona mesmo com PATH restrito a este dir.
# Loga argv em $QS_FAKE_LOG quando definido (padrão dos fakebins).
if [ -n "${QS_FAKE_LOG:-}" ]; then
  printf 'upower %s\n' "$*" >> "$QS_FAKE_LOG"
fi
if [ "$1" = "-e" ]; then
  printf '%s\n' "/org/freedesktop/UPower/devices/line_power_AC"
  printf '%s\n' "/org/freedesktop/UPower/devices/battery_BAT0"
elif [ "$1" = "-i" ]; then
  printf '%s\n' "  native-path:          BAT0"
  printf '%s\n' "  vendor:               Test"
  printf '%s\n' "  model:                Fake Battery"
  printf '%s\n' "  power supply:         yes"
  printf '%s\n' "  updated:              Mon Jan  1 00:00:00 2024 (0 seconds ago)"
  printf '%s\n' "  has history:          yes"
  printf '%s\n' "  has statistics:       yes"
  printf '%s\n' "  battery"
  printf '%s\n' "    present:             yes"
  printf '%s\n' "    rechargeable:        yes"
  printf '%s\n' "    state:               discharging"
  printf '%s\n' "    warning-level:       none"
  printf '%s\n' "    energy:              42 Wh"
  printf '%s\n' "    energy-empty:        0 Wh"
  printf '%s\n' "    energy-full:         50 Wh"
  printf '%s\n' "    energy-full-design:  55 Wh"
  printf '%s\n' "    energy-rate:         7 W"
  printf '%s\n' "    voltage:             11 V"
  printf '%s\n' "    time to empty:       1.5 hours"
  printf '%s\n' "    percentage:          42%"
  printf '%s\n' "    capacity:            90%"
  printf '%s\n' "    technology:          lithium-ion"
fi

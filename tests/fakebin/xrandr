#!/bin/sh
# xrandr falso para testes E2E: loga argv; --query retorna dump com 2 monitores.
if [ -n "${QS_FAKE_LOG:-}" ]; then
  printf 'xrandr %s\n' "$*" >> "$QS_FAKE_LOG"
fi
if [ "$1" = "--query" ]; then
  printf '%s\n' \
    "Screen 0: minimum 8 x 8, current 1920 x 1080, maximum 32767 x 32767" \
    "HDMI-1 connected primary 1920x1080+0+0 (normal left inverted right x axis y axis) 510mm x 290mm" \
    "   1920x1080     60.00*+  59.94" \
    "   1280x720      60.00" \
    "DP-1 connected 1280x1024+1920+0 (normal left inverted right x axis y axis) 380mm x 300mm" \
    "   1280x1024     60.00*+" \
    "   1024x768      60.00"
fi
exit 0
